{
  "version": 1,
  "workspace": {
    "id": "one-dashboard-dev",
    "name": "Dashboard Development"
  },
  "environments": {
    "names": [
      "dev",
      "preview",
      "prod"
    ],
    "default": "dev"
  },
  "projects": [
    {
      "name": "web",
      "relativeDir": "apps/web",
      "templateId": "react-spa",
      "toolchain": "node",
      "buildVersion": "1.4.0",
      "packageManager": "pnpm",
      "env": {
        "path": ".env",
        "inherits": true,
        "keys": [
          "API_URL",
          "PUBLIC_APP_NAME"
        ]
      },
      "dev": {
        "command": "pnpm dev"
      }
    },
    {
      "name": "api",
      "relativeDir": "services/api",
      "templateId": "go-api",
      "toolchain": "go",
      "buildVersion": "2.1.0",
      "env": {
        "path": ".env",
        "inherits": true,
        "keys": [
          "DATABASE_URL",
          "PORT"
        ]
      },
      "dev": {
        "command": "go run ./cmd/server"
      }
    },
    {
      "name": "docs",
      "relativeDir": "apps/docs",
      "templateId": "starlight-docs",
      "toolchain": "node",
      "buildVersion": "0.8.0",
      "packageManager": "pnpm",
      "env": {
        "inherits": true,
        "keys": [
          "PUBLIC_DOCS_URL"
        ]
      },
      "dev": {
        "command": "pnpm dev"
      }
    },
    {
      "name": "shared",
      "relativeDir": "packages/shared",
      "templateId": "ts-library",
      "toolchain": "node",
      "buildVersion": "0.5.0",
      "packageManager": "pnpm",
      "env": {
        "inherits": true,
        "keys": [
          "LOG_LEVEL"
        ]
      },
      "dev": {
        "command": "pnpm build --watch"
      }
    }
  ],
  "env": {}
}
