{
  "name": "one-template-deno-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "deno check src/main.ts",
    "lint": "deno lint",
    "format:check": "deno fmt --check",
    "format:fix": "deno fmt",
    "test": "deno test --permit-no-files",
    "build": "deno compile --allow-net --allow-env=PORT --output dist/server src/main.ts",
    "dev": "deno run --watch --allow-net --allow-env=PORT src/main.ts",
    "start": "deno run --allow-net --allow-env=PORT src/main.ts"
  }
}
