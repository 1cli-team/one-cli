{
	"name": "nextjs-site-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "serve out",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run format",
		"check:fix": "pnpm run lint:fix && pnpm run format:fix",
		"preview": "serve out",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.49.0",
		"next": "^16.3.7",
		"next-themes": "^0.4.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"shadcn": "^4.21.0",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24.19.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"git-cz": "^4.9.0",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"postcss": "^8.5.28",
		"serve": "^14.2.5",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs}": [
			"oxlint --fix",
			"oxfmt --write --no-error-on-unmatched-pattern"
		],
		"*.{json,md,css,scss,html,yml,yaml}": [
			"oxfmt --write --no-error-on-unmatched-pattern"
		]
	},
	"engines": {
		"node": "^24.15.0 || >=26.0.0"
	},
	"packageManager": "pnpm@12.3.4"
}
