{
	"name": "nextjs-app-template",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"check": "pnpm run lint && pnpm run format",
		"check:fix": "pnpm run lint:fix && pnpm run format:fix"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"axios": "^1.20.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.43.0",
		"next": "^16.3.4",
		"next-themes": "^0.4.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sonner": "^2.0.8",
		"swr": "^2.5.1",
		"tailwind-merge": "^3.6.0",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24.13.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"git-cz": "^4.9.0",
		"lint-staged": "^17.5.0",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"postcss": "^8.5.28",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs}": [
			"oxlint --fix",
			"oxfmt --write --no-error-on-unmatched-pattern"
		],
		"*.{json,md,css,scss,html,yml,yaml}": [
			"oxfmt --write --no-error-on-unmatched-pattern"
		]
	},
	"engines": {
		"node": "^24.15.0 || >=26.0.0"
	},
	"packageManager": "pnpm@12.3.4"
}
