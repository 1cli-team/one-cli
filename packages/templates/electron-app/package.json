{
  "name": "one-template-electron",
  "version": "0.1.0",
  "private": true,
  "description": "electron-template",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "workspaces": [
    "apps/one-template-electron-renderer",
    "services/one-template-electron-main",
    "packages/one-template-electron-preload"
  ],
  "scripts": {
    "dev": "pnpm -F @one-template-electron/preload build && pnpm -r --parallel -F @one-template-electron/main -F @one-template-electron/renderer -F @one-template-electron/preload run dev",
    "build": "pnpm --filter @one-template-electron/main... run build",
    "test": "pnpm -F @one-template-electron/preload run build && pnpm -F @one-template-electron/main run test",
    "pack": "pnpm run build && pnpm -F @one-template-electron/main run pack",
    "sandbox:profile": "pnpm --silent -F @one-template-electron/main run sandbox:profile",
    "release": "pnpm run build && pnpm -F @one-template-electron/main run release",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
