{
  "name": "@one-template-electron/preload",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "./channels": {
      "types": "./dist/channels.d.ts",
      "import": "./dist/channels.js"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
